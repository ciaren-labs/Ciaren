{
  "name": "Ciaren",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "postCreateCommand": "bash .devcontainer/ciaren.sh install",
  "postAttachCommand": "bash .devcontainer/ciaren.sh serve",
  "waitFor": "postCreateCommand",
  "portsAttributes": {
    "8055": {
      "label": "Ciaren editor",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [".devcontainer/WELCOME.md"]
    },
    "vscode": {
      "settings": {
        "workbench.startupEditor": "none"
      }
    }
  },
  "remoteEnv": {
    "PATH": "/workspaces/.ciaren/venv/bin:${containerEnv:PATH}"
  }
}
