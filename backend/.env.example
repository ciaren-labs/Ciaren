# All env vars are prefixed with CIAREN_
# Copy this file to .env and fill in real values.

CIAREN_ENVIRONMENT=development
CIAREN_DEBUG=true

# SQLite (default, no setup required)
CIAREN_DATABASE_URL=sqlite+aiosqlite:///./ciaren.db

# PostgreSQL example
# CIAREN_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ciaren

CIAREN_DATA_DIR=.data
CIAREN_CORS_ORIGINS=["http://localhost:5173"]
CIAREN_MAX_UPLOAD_SIZE_MB=100

# Optional Flow Assistant. UI overrides apply to provider, model and effort.
# See docs/guide/flow-assistant.md for all four providers and secret sources.
# CIAREN_ASSISTANT_PROVIDER=off
# CIAREN_ASSISTANT_ENABLED=false
# CIAREN_ASSISTANT_TURNS_PER_HOUR=20
# CIAREN_ASSISTANT_TOKENS_PER_HOUR=
# CIAREN_ASSISTANT_OPENAI_MODEL=gpt-5-mini
# CIAREN_ASSISTANT_OPENAI_EFFORT=low
# CIAREN_ASSISTANT_OPENAI_KEY_SOURCE=file
# CIAREN_ASSISTANT_SECRET_DIR=/run/ciaren-assistant-secrets
